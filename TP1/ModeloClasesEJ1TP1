classDiagram
    class Pedido {
        -int numero
        -LocalDate fechaEntrega
        -Cliente cliente
        -List~ItemPedido~ articulos
        -List~Remito~ remitos
        -EstadoPedido estado
        +agregarArticulo(Articulo articulo, int cantidad) void
        +agregarRemito(Remito remito) void
        +cerrar() void
        +entregar() void
        +reabrir() void
        +setEstado(EstadoPedido nuevoEstado) void
    }

    class EstadoPedido {
        <<interface>>
        +agregarArticulo(Pedido pedido, Articulo articulo, int cantidad)* void
        +agregarRemito(Pedido pedido, Remito remito)* void
        +reabrir(Pedido pedido)* void
    }

    class Abierto {
        +agregarArticulo(Pedido pedido, Articulo articulo, int cantidad) void
        +agregarRemito(Pedido pedido, Remito remito) void
        +reabrir(Pedido pedido) void
    }

    class Cerrado {
        +agregarArticulo(Pedido pedido, Articulo articulo, int cantidad) void
        +agregarRemito(Pedido pedido, Remito remito) void
        +reabrir(Pedido pedido) void
    }

    class Entregado {
        +agregarArticulo(Pedido pedido, Articulo articulo, int cantidad) void
        +agregarRemito(Pedido pedido, Remito remito) void
        +reabrir(Pedido pedido) void
    }

    class Cliente {
        -String id
        -String nombre
    }

    class ItemPedido {
        -int cantidad
        -double precioUnitario
        -Articulo articulo
        +getSubtotal() double
    }

    class Articulo {
        -String codigo
        -String descripcion
    }

    class Remito {
        -int numero
        -LocalDate fechaEmision
        -List~ItemPedido~ articulos
        +agregarItem(ItemPedido item) void
    }

    Pedido --> Cliente : cliente
    Pedido *-- ItemPedido : contiene
    ItemPedido --> Articulo : referencia
    Pedido *-- Remito : cancelado por
    Remito o-- ItemPedido : incluye

    Pedido o--> EstadoPedido : estado actual
    EstadoPedido <|.. Abierto : implementa
    EstadoPedido <|.. Cerrado : implementa
    EstadoPedido <|.. Entregado : implementa
